---
import Sidebar from '../components/Sidebar.astro';
import { SITE_NAME } from '../lib/config';

interface Props {
  title: string;
  /** 本文をビューポートいっぱいに広げ、ページ自体はスクロールさせない */
  fullscreen?: boolean;
  /** 本文の幅を読み物向けに狭める（動画や図をその幅いっぱいに置くページ用） */
  narrow?: boolean;
  /** 本文中の画像の高さを一律に揃える（px）。書影のように縦横比がまちまちなものを並べるページ用 */
  imageHeight?: number;
  /** 画像を左に置き、続く説明をその右に回り込ませる（imageHeight と併用する） */
  imageSide?: boolean;
}

const { title, fullscreen = false, narrow = false, imageHeight, imageSide = false } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | {SITE_NAME}</title>
    <!-- ページ固有の <head> 追記（webフォントなど）。使わないページは何も出ない -->
    <slot name="head" />
  </head>
  <body>
    <div
      class:list={[
        'app',
        { fullscreen, narrow, 'fixed-image-height': imageHeight != null, 'side-image': imageSide },
      ]}
      style={imageHeight != null ? `--image-height: ${imageHeight}px` : undefined}
    >
      <button id="nav-toggle" type="button" aria-expanded="true" aria-controls="sidebar" title="サイドメニューの開閉（\\）">
        <span class="bar"></span><span class="bar"></span><span class="bar"></span>
      </button>
      <aside class="sidebar" id="sidebar">
        <Sidebar />
      </aside>
      <main class="main">
        <article class="prose">
          <slot />
        </article>
      </main>
    </div>
    <dialog id="img-dialog">
      <img id="img-dialog-img" src="" alt="" />
    </dialog>
  </body>
</html>

<script>
  // サイドメニューの開閉。状態は端末ごとの好みなので localStorage に持つ
  {
    const app = document.querySelector('.app') as HTMLElement;
    const toggle = document.getElementById('nav-toggle') as HTMLButtonElement;
    const KEY = 'nav-closed';
    const apply = (closed: boolean) => {
      app.classList.toggle('nav-closed', closed);
      toggle.setAttribute('aria-expanded', String(!closed));
    };
    let closed = false;
    try { closed = localStorage.getItem(KEY) === '1'; } catch (e) { /* 使えない環境では開いたまま */ }
    apply(closed);
    const set = (next: boolean) => {
      closed = next;
      apply(closed);
      try { localStorage.setItem(KEY, closed ? '1' : '0'); } catch (e) { /* 保存できなくても動く */ }
    };
    toggle.addEventListener('click', () => set(!closed));
    document.addEventListener('keydown', (e) => {
      const el = document.activeElement as HTMLElement | null;
      if (el && /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)) return;
      if (e.key === '\\') { set(!closed); e.preventDefault(); }
    });
  }

  const dialog = document.getElementById('img-dialog') as HTMLDialogElement;
  const dialogImg = document.getElementById('img-dialog-img') as HTMLImageElement;

  document.querySelectorAll('.image-scroll img').forEach((img) => {
    (img as HTMLImageElement).style.cursor = 'zoom-in';
    img.addEventListener('click', () => {
      dialogImg.src = (img as HTMLImageElement).src;
      dialogImg.alt = (img as HTMLImageElement).alt;
      dialog.showModal();
    });
  });

  dialog.addEventListener('click', () => dialog.close());
</script>

<style is:global>
  :root {
    --bg: #fafaf8;
    --fg: #1a1a1a;
    --muted: #6b6b6b;
    --border: #e5e5e0;
    --link: #2847a1;
    --link-hover: #1a2f6b;
    --sidebar-bg: #f2f1ec;
    --font-sans: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "Noto Sans JP", sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, monospace;
    --font-serif: "YuMincho", "Hiragino Mincho ProN", "Noto Serif JP", serif;
  }

  * {
    box-sizing: border-box;
  }

  html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.7;
  }

  .app {
    display: grid;
    grid-template-columns: 280px 1fr;
    min-height: 100vh;
  }

  .sidebar {
    background: var(--sidebar-bg);
    border-right: 1px solid var(--border);
    padding: 24px 20px;
    position: sticky;
    top: 0;
    max-height: 100vh;
    overflow-y: auto;
  }

  .main {
    padding: 48px 56px;
    min-width: 0;
  }

  /* 全画面のページ。本文が画面の高さぴったりに収まり、ページはスクロールしない */
  .app.fullscreen {
    height: 100dvh;
    overflow: hidden;
  }
  .app.fullscreen .main {
    padding: 0;
    height: 100dvh;
    overflow: hidden;
  }
  .app.fullscreen .prose {
    max-width: none;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* サイドメニューの開閉。閉じると本文が全幅になる */
  .app.nav-closed {
    grid-template-columns: 1fr;   /* sidebar を消すので本文だけの1列にする */
  }
  .app.nav-closed .sidebar {
    display: none;
  }
  #nav-toggle {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 20;
    width: 30px;
    height: 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 0 7px;
    background: var(--sidebar-bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
    opacity: 0.45;
    transition: opacity 0.15s;
  }
  #nav-toggle:hover,
  #nav-toggle:focus-visible {
    opacity: 1;
  }
  #nav-toggle .bar {
    display: block;
    height: 1px;
    background: var(--fg);
  }
  .app.nav-closed #nav-toggle {
    background: var(--bg);
  }

  .prose {
    max-width: 960px;
  }
  .app.narrow .prose {
    max-width: 720px;
  }

  /* 縦横比がまちまちな画像を、高さだけ揃えて並べる */
  .app.fixed-image-height .prose img {
    height: var(--image-height);
    width: auto;
    margin: 16px 0;
  }

  /* 画像を左に、説明をその右に。画像の幅はまちまちなので、置き場の幅の方を固定して
     説明の左端が全項目でそろうようにする */
  .app.side-image .prose {
    display: flow-root;
  }
  .app.side-image .prose p:has(img) {
    float: left;
    width: calc(var(--image-height, 260px) * 0.78);
    margin: 16px 28px 32px 0;
  }
  .app.side-image .prose p:has(img) img {
    margin: 0;
  }
  /* 回り込む側は独立したブロックにして、行が画像に食い込まないようにする */
  .app.side-image .prose ul,
  .app.side-image .prose ol,
  .app.side-image .prose table,
  .app.side-image .prose p:not(:has(img)) {
    overflow: hidden;
  }
  .app.side-image .prose h1,
  .app.side-image .prose h2,
  .app.side-image .prose h3,
  .app.side-image .prose h4,
  .app.side-image .prose hr {
    clear: both;
  }
  /* 画面が狭いときは横並びをやめて元の縦積みに戻す */
  @media (max-width: 700px) {
    .app.side-image .prose p:has(img) {
      float: none;
      width: auto;
      margin: 16px 0;
    }
  }

  .prose a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose a:hover {
    color: var(--link-hover);
  }

  .prose h1 {
    font-size: 28px;
    margin: 0 0 24px;
    line-height: 1.3;
  }
  .prose h2 {
    font-size: 20px;
    margin: 40px 0 12px;
    line-height: 1.4;
    border-bottom: 1px solid var(--border);
    padding-bottom: 6px;
  }
  .prose h3 {
    font-size: 17px;
    margin: 28px 0 10px;
  }
  .prose p {
    margin: 12px 0;
    font-size: 14px;
  }
  .prose ul, .prose ol {
    margin: 12px 0;
    padding-left: 24px;
  }
  .prose li {
    margin: 4px 0;
  }
  .prose code {
    font-family: var(--font-mono);
    background: #ebeae5;
    padding: 2px 5px;
    border-radius: 3px;
    font-size: 0.9em;
  }
  .prose pre {
    background: #22221f;
    color: #e5e5e0;
    padding: 16px 20px;
    border-radius: 12px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
  }
  .prose pre code {
    background: transparent;
    padding: 0;
    color: inherit;
  }
  .prose blockquote {
    margin: 16px 0;
    padding: 4px 16px;
    border-left: 3px solid var(--border);
    color: var(--muted);
  }
  /* Visually hidden: the GFM footnote plugin emits an English "Footnotes"
     heading with this class. Pages write their own 出典 heading above it. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .prose .footnotes {
    margin-top: 24px;
    padding-top: 8px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--muted);
  }
  .prose .footnotes ol {
    padding-left: 20px;
  }
  .prose .footnotes li {
    margin: 6px 0;
  }
  .prose .footnotes li p {
    margin: 0;
  }
  .prose sup a[data-footnote-ref] {
    padding: 0 1px;
    font-size: 11px;
    text-decoration: none;
  }
  .prose a[data-footnote-backref] {
    text-decoration: none;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 16px auto;
    border: 1px solid var(--border);
  }
  .prose .figcaption {
    margin: -8px 0 20px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--muted);
    text-align: center;
  }
  .prose .image-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 16px 0;
  }
  .prose .image-row > p {
    margin: 0;
    aspect-ratio: 4 / 5;
  }
  .prose .image-row img {
    margin: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 600px) {
    .prose .image-row {
      grid-template-columns: 1fr;
    }
    .prose .image-row > p {
      aspect-ratio: auto;
    }
    .prose .image-row img {
      height: auto;
    }
  }
  /*
   * 本文の横に回り込ませる補足画像。
   *   <div class="fig-right"> … </div>   本文の右に置く（左に文字が回り込む）
   *   <div class="fig-left">  … </div>   本文の左に置く
   * キャプション（<p class="caption">）は div の中に入れる。
   * 幅は本文より小さく取る。補足なので、読む邪魔をしない大きさに収める。
   */
  .prose .fig-right,
  .prose .fig-left {
    width: clamp(160px, 36%, 300px);
    margin: 6px 0 12px;
  }
  .prose .fig-right { float: right; margin-left: 28px; }
  .prose .fig-left  { float: left;  margin-right: 28px; }
  .prose .fig-right img,
  .prose .fig-left img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }
  .prose .fig-right p,
  .prose .fig-left p {
    margin: 6px 0 0;
  }
  /* 節の切れ目で回り込みを解除する。見出しが画像の横に食い込まないように */
  .prose h2,
  .prose h3,
  .prose h4,
  .prose hr {
    clear: both;
  }
  /* 画面が狭いときは回り込みをやめて、本文の流れの中に置く */
  @media (max-width: 700px) {
    .prose .fig-right,
    .prose .fig-left {
      float: none;
      width: min(70%, 320px);
      margin: 16px auto;
    }
  }

  .prose .image-half {
    margin: 16px 0;
  }
  .prose .image-half img {
    max-width: 50%;
  }
  /* Figmaから書き出した横長の図版。縮めると文字が潰れるので原寸で置き、横スクロールさせる */
  .prose .fig-wide {
    margin: 24px 0 14px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }
  .prose .fig-wide img {
    display: block;
    width: 100%;
    /* これ以下に縮むと注記の文字が潰れるので、狭い画面ではここで横スクロールに切り替わる */
    min-width: 660px;
    max-width: 1330px;
    height: auto;
    margin: 0;
    border: 0;
  }
      /* 図の下に置く一行の説明。画像の直後に来たときだけ詰める */
  .prose .caption {
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
  }
  .prose .image-half + .caption,
  .prose .image-small + .caption,
  .prose .image-full + .caption,
  .prose .tree + .caption {
    margin-top: -8px;
  }
  .prose .image-small {
    margin: 16px 0;
  }
  .prose .image-small img {
    max-width: 25%;
  }
  .prose .image-scroll {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    overflow-x: auto;
    margin: 16px 0 16px -56px;
    padding: 0 56px;
    width: calc(100vw - 280px);
    max-width: none;
    scrollbar-width: thin;
  }
  .prose .image-scroll > p {
    flex: 0 0 auto;
    margin: 0;
  }
  .prose .image-scroll img {
    height: 420px;
    width: auto;
    max-width: none;
    margin: 0;
    border: none;
    display: block;
    border-radius: 2px;
  }
  .prose .video-embed {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    margin: 16px 0;
  }
  .prose .video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .prose table {
    border-collapse: collapse;
    margin: 16px 0;
    font-size: 14px;
  }
  .prose th, .prose td {
    border: 1px solid var(--border);
    padding: 6px 12px;
    text-align: left;
  }
  .prose th {
    background: #ebeae5;
  }

  /* 会話例リスト */
  .prose .phrase-section h2 {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    border-bottom: none;
    padding-bottom: 0;
    margin: 40px 0 8px;
  }
  /* 場面の絵。見出しカードの真上に置く */
  .prose .phrase-section p:has(img) {
    margin: 32px 0 0;
  }
  .prose .phrase-section p:has(img) img {
    height: 240px;
    width: auto;
    max-width: 100%;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .prose .phrase-section h3 {
    font-size: 20px;
    font-weight: 400;
    margin: 10px 0 0;
    line-height: 1.4;
    padding: 14px 18px 12px;
    background: var(--sidebar-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .prose .phrase-section h3:has(+ p) {
    border-radius: 12px 12px 0 0;
    border-bottom: none;
  }
  .prose .phrase-section h3 + p {
    margin: 0 0 4px;
    padding: 4px 18px 14px;
    background: var(--sidebar-bg);
    border: 1px solid var(--border);
    border-top: none;
    border-radius: 0 0 12px 12px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }
  .prose .phrase-section .easy,
  .prose .phrase-section .normal,
  .prose .phrase-section .hard,
  .prose .phrase-section .solo {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .prose .phrase-section .easy   { background: #dff0df; color: #2a6b2a; border: 1px solid #b5d9b5; }
  .prose .phrase-section .normal { background: #f5ead4; color: #7a5200; border: 1px solid #e0cc99; }
  .prose .phrase-section .hard   { background: #f5dede; color: #8b2020; border: 1px solid #e0b0b0; }
  .prose .phrase-section .solo   { background: #eae8f0; color: #4a3d6b; border: 1px solid #c5bed9; }

  .prose .phrase-section .freq-high,
  .prose .phrase-section .freq-mid,
  .prose .phrase-section .freq-low {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 7px;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .prose .phrase-section .freq-high { background: #deeaf8; color: #1a4f8a; border: 1px solid #9ec3e8; }
  .prose .phrase-section .freq-mid  { background: #f0f0f0; color: #666;   border: 1px solid #ccc; }
  .prose .phrase-section .freq-low  { background: #fafafa; color: #aaa;   border: 1px solid #ddd; }

  /* h3 内: 頻出度タグを関係値タグに寄せる */
  .prose .phrase-section h3 [class^="freq"] {
    margin-left: -6px;
    border-radius: 20px;
    font-size: 12px;
    padding: 3px 10px;
  }

  /* フィルター UI */
  .phrase-filter {
    margin-bottom: 16px;
    padding: 12px 16px;
    background: var(--sidebar-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .phrase-filter-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .phrase-filter-label {
    font-size: 11px;
    color: #888;
    width: 44px;
    flex-shrink: 0;
  }
  .filter-btn {
    cursor: pointer;
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
    background: none;
    opacity: 0.4;
    transition: opacity 0.15s;
  }
  .filter-btn:hover { opacity: 0.7; }
  .filter-btn[data-active="true"] { opacity: 1; outline: 2px solid currentColor; outline-offset: 1px; }
  .filter-btn.easy   { background: #dff0df; color: #2a6b2a; border: 1px solid #b5d9b5; }
  .filter-btn.normal { background: #f5ead4; color: #7a5200; border: 1px solid #e0cc99; }
  .filter-btn.hard   { background: #f5dede; color: #8b2020; border: 1px solid #e0b0b0; }
  .filter-btn.solo   { background: #eae8f0; color: #4a3d6b; border: 1px solid #c5bed9; }
  .filter-btn.freq-high { background: #deeaf8; color: #1a4f8a; border: 1px solid #9ec3e8; }
  .filter-btn.freq-mid  { background: #f0f0f0; color: #666;   border: 1px solid #ccc; }
  .filter-btn.freq-low  { background: #fafafa; color: #aaa;   border: 1px solid #ddd; }

  /* 一問一答レイアウト */
  .prose .qa-section h1 {
    font-size: 18px;
    font-weight: 600;
    margin: 40px 0 24px;
    border-top: 1px solid var(--border);
    padding-top: 32px;
  }
  .prose .qa-section h2 {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    border-bottom: none;
    padding-bottom: 0;
    margin: 32px 0 4px;
  }
  .prose .qa-section h3 {
    font-size: 13px;
    font-weight: normal;
    color: var(--muted);
    margin: 14px 0 2px;
    line-height: 1.5;
  }
  .prose .qa-section h3 + p {
    margin-top: 2px;
    font-weight: 500;
  }
  .prose .qa-section hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 28px 0 0;
  }
  .prose .qa-section ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
  }
  .prose .qa-section ul li {
    background: var(--bg-subtle, #f0efe9);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 13px;
    line-height: 1.6;
  }

  .prose ol.q-list {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    counter-reset: q-num;
  }
  .prose ol.q-list[start='7']  { counter-reset: q-num 6;  }
  .prose ol.q-list[start='11'] { counter-reset: q-num 10; }
  .prose ol.q-list[start='15'] { counter-reset: q-num 14; }
  .prose ol.q-list[start='19'] { counter-reset: q-num 18; }
  .prose ol.q-list[start='24'] { counter-reset: q-num 23; }
