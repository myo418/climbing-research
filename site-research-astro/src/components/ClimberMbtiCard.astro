---
// クライマーMBTI のタイプカード。情報ページと診断ページの両方が使う。
// 中身の差し替えは src/scripts/climber-mbti-card.ts が行う（このファイルは見た目だけ）。
import { axes, groups, types, typeIndex } from '../data/climber-mbti';

interface Props {
  /** カードの肩に出す文字。診断結果なら「あなたのタイプ」など */
  label?: string;
  /** 「もう一度やる」を置くか（診断ページ用） */
  redo?: boolean;
  /** 見本のカードか。true なら Example を大きく出す（解説ページ用） */
  example?: boolean;
  /** プレビュー（カード）と5軸のバーを左右に並べる */
  side?: boolean;
}

const { label = '例', redo = false, example = false, side = false } = Astro.props;

// 初期表示。JS が動く前からカードが正しく出るよう、サーバー側でも同じ値で描く
const initial = [0, 1, 1, 0, 0];
const initialGroup =
  groups.find((g) => g.ground === initial[2] && g.commitment === initial[3]) ?? groups[0];
const initialType = types[typeIndex(initial[0], initial[1], initial[2], initial[3])];
// 1〜4文字目が16タイプ、5文字目がその2バージョン。境目にハイフンを入れる
const initialLetterList = axes.map((a, i) => a.poles[initial[i]].letter);
const initialLetters = `${initialLetterList.slice(0, 4).join('')}-${initialLetterList[4]}`;
const initialWords = axes.map((a, i) => a.poles[initial[i]].word).join(' · ');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 絵は public/climber-mbti/<pattern>/ に lineart と poly の2種類あるが、
// ページに出すのは poly だけ（線画版は作り直すまで寝かせる）
const pattern = 'poly';
const poleArt = (word: string) => `${base}/climber-mbti/${pattern}/axis-${word.toLowerCase()}.webp`;
---

<div class={`cm-cardset${side ? ' is-side' : ''}`}>
<div class={`cm-card${example ? ' is-example' : ''}`} id="cm-card" style={`--tape: ${initialGroup.tape}`}>
  {example && <span class="cm-example" aria-hidden="true">Example</span>}
  <div class="cm-card-top">
    <span class="cm-group" id="cm-group">{initialGroup.jp} {initialGroup.en}</span>
    {!example && <span class="cm-dan" id="cm-state-label">{label}</span>}
    {redo && <button class="cm-redo" id="cm-redo" type="button" hidden>もう一度やる</button>}
  </div>
  <img
    class="cm-card-art"
    id="cm-card-art"
    src={`${base}/climber-mbti/${pattern}/${initialType.slug}.webp`}
    data-slug={initialType.slug}
    alt={initialType.jp}
  />
  <div class="cm-title">
    <span class="cm-name" id="cm-name">{initialType.jp}</span>
    <span class="cm-en" id="cm-en">{initialType.en}</span>
  </div>
  <div class="cm-ident">
    <div class="cm-code" id="cm-code">
      {axes.map((axis, i) => (
        <span class={i === 4 ? 'tail' : ''} data-slot={i}>{axis.poles[initial[i]].kanji}</span>
      ))}
    </div>
    <div class="cm-letters" id="cm-letters">{initialLetters}</div>
  </div>
  <div class="cm-words" id="cm-words">{initialWords}</div>
  <p class="cm-body" id="cm-body">{initialType.body}</p>
  <p class="cm-variant">
    <b id="cm-variant-label">感 Feel</b><span id="cm-variant-text">{initialType.feel}</span>
  </p>
</div>

<div class="cm-traits">
  {axes.map((axis, i) => (
    <div class="cm-trait">
      <span class="cm-axis-tag">{String(axis.no).padStart(2, '0')} {axis.en}</span>
      <button
        class="cm-side left"
        type="button"
        data-axis={i}
        data-pole="0"
        aria-pressed={initial[i] === 0 ? 'true' : 'false'}
      >
        <img class="cm-side-art" src={poleArt(axis.poles[0].word)} alt="" loading="lazy" />
        <span class="cm-side-text">
          <span class="jp">{axis.poles[0].kanji}</span>
          <span class="en">{axis.poles[0].word} · {axis.poles[0].letter}</span>
        </span>
      </button>
      <div class="cm-track">
        <div class="cm-thumb" style={`left: ${initial[i] === 0 ? '8%' : '92%'}`}></div>
      </div>
      <button
        class="cm-side right"
        type="button"
        data-axis={i}
        data-pole="1"
        aria-pressed={initial[i] === 1 ? 'true' : 'false'}
      >
        <img class="cm-side-art" src={poleArt(axis.poles[1].word)} alt="" loading="lazy" />
        <span class="cm-side-text">
          <span class="jp">{axis.poles[1].kanji}</span>
          <span class="en">{axis.poles[1].word} · {axis.poles[1].letter}</span>
        </span>
      </button>
    </div>
  ))}
</div>
</div>


<style is:global>
  /* このページ全体を中央揃えにする。cm-root は各ページが中身を包む目印。
     このCSSは、このコンポーネントを使うページにしか読み込まれない */
  .prose:has(.cm-root) {
    /* 本文の 960px 制限をこのページだけ外す。
       カードと5軸のバーの行を、使える幅いっぱいに広げるため。
       本文として読ませたい塊（リード・表・判定基準）は各自で幅を持っている */
    max-width: none;
    margin-inline: auto;
    text-align: center;
    /* 中の要素が「画面幅」ではなく「本文の幅」で折り返しを判断できるようにする。
       サイドバーが開いていると本文は画面より 280px 以上狭い */
    container-type: inline-size;
  }
  .prose:has(.cm-root) h1,
  .prose:has(.cm-root) h2,
  .prose:has(.cm-root) h3,
  .prose:has(.cm-root) p {
    text-align: center;
  }
  /* 各節の導入文は小組にする。本文の幅制限を外したので、
     指定しないと1行が伸びきって読めなくなる。ボタンの行は対象外 */
  .prose:has(.cm-root) > .cm-root > p:not(.cm-cta-row) {
    max-width: 34em;
    margin-inline: auto;
    font-size: 0.875rem;
    line-height: 2.05;
    color: var(--muted);
  }
</style>

<style>
  /* ---- card ---- */
  .cm-cardset.is-side {
    /* プレビュー（カード）と5軸のバーを左右に並べる。
       縦に積むと絵とバーが離れて、ひとつの組に見えないため */
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6cqi, 4.5rem);
    align-items: center;
    margin: 0 auto 3rem;
  }
  .cm-cardset.is-side .cm-card { max-width: none; margin: 0; }
  .cm-cardset.is-side .cm-traits { max-width: none; margin: 0; }

  @container (max-width: 760px) {
    .cm-cardset.is-side { grid-template-columns: 1fr; gap: 1.5rem; }
    .cm-cardset.is-side .cm-card,
    .cm-cardset.is-side .cm-traits { max-width: 560px; margin-inline: auto; }
  }

  .cm-card {
    --tape: var(--border);
    /* 本文の幅（960px）いっぱいに広げない。
       中の絵は 360px なので、箱だけ広いと絵が見出しから離れて見える */
    max-width: 560px;
    margin: 0 auto;
    border: 1px solid var(--border);
    border-top: 6px solid var(--tape);
    background: #fff;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .cm-card-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.5rem; }
  .cm-group {
    background: var(--tape);
    color: #fff;
    padding: 2px 0.75rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  .cm-card.is-example { position: relative; }
  .cm-example {
    /* 見本であることが一目で分かるように。貼り紙のようにカードの肩へ */
    position: absolute;
    top: -0.62em;
    left: 1rem;
    z-index: 2;
    display: inline-block;
    transform: rotate(-3deg);
    transform-origin: left center;
    background: var(--tape);
    color: #fff;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.5rem, 4.4vw, 2.25rem);
    line-height: 1;
    letter-spacing: 0.02em;
    padding: 0.3em 0.7em 0.36em;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.14);
  }
  @media (max-width: 480px) {
    .cm-example { left: 0.75rem; }
  }

  .cm-dan {
    border: 1px solid var(--border);
    color: var(--muted);
    padding: 2px 0.5rem;
    font-size: 0.75rem;
    font-family: ui-monospace, SFMono-Regular, monospace;
    letter-spacing: 0.1em;
  }
  .cm-ident {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.25rem 1rem;
    margin-top: -0.25rem;
  }
  .cm-code {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25em;
    font-size: clamp(1.125rem, 3.2vw, 1.5rem);
    line-height: 1;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .cm-code .tail { color: var(--tape); }
  .cm-title { display: flex; flex-direction: column; align-items: center; gap: 2px; }
  .cm-name {
    /* カードの主役。ここがいちばん大きい */
    font-size: clamp(1.75rem, 6vw, 3.25rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }
  .cm-en {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    color: var(--tape);
  }
  .cm-letters {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.3em;
    color: var(--muted);
  }
  .cm-words {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-top: -0.75rem;
  }
  .cm-body { line-height: 1.95; max-width: 62ch; margin: 0 auto; }
  .cm-variant {
    border-top: 1px solid var(--border);
    padding-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.85;
    max-width: 62ch;
    margin: 0 auto;
  }
  .cm-variant b { color: var(--tape); }
  .cm-variant b { color: var(--fg); margin-right: 0.75rem; }

  .cm-card-art {
    display: block;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    background: #fff;
    align-self: center;
  }
  .cm-type-art {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    background: #fff;
    border: 1px solid var(--border);
    margin-bottom: 0.25rem;
  }
  .cm-pole-art {
    display: block;
    width: 100%;
    max-width: 190px;
    margin-inline: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    background: #fff;
    border: 1px solid var(--border);
    margin-bottom: 0.375rem;
  }



  /* ---- trait bars ---- */
  .cm-traits { display: flex; flex-direction: column; max-width: 560px; margin: 1.5rem auto 3rem; }
  .cm-trait {
    --tape: var(--border);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(80px, 190px) minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
  }
  .cm-trait:first-child { border-top: 1px solid var(--border); }
  .cm-axis-tag {
    grid-column: 1 / -1;
    order: -1;
    text-align: center;
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .cm-side {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font: inherit;
    color: var(--muted);
    opacity: 0.55;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    text-align: left;
    transition: opacity 160ms ease, color 160ms ease;
  }
  .cm-trait .cm-side { flex-direction: row; align-items: center; gap: 0.75rem; }
  .cm-trait .cm-side.right { text-align: right; flex-direction: row-reverse; }
  .cm-side-text { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .cm-side.right .cm-side-text { align-items: flex-end; }
  /* .prose img が margin:16px auto / display:block を当ててくるので、ここで打ち消す */
  .cm-trait .cm-side .cm-side-art {
    flex: 0 0 auto;
    width: clamp(44px, 6vw, 72px);
    height: clamp(44px, 6vw, 72px);
    margin: 0;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    background: #fff;
    border: 1px solid var(--border);
  }
  .cm-side:hover { opacity: 1; }
  .cm-side[aria-pressed='true'] { opacity: 1; color: var(--fg); }
  .cm-side[aria-pressed='true'] .en { color: var(--tape); }
  .cm-side .jp { font-size: 1.0625rem; font-weight: 700; line-height: 1.4; }
  .cm-side .en { font-family: ui-monospace, SFMono-Regular, monospace; font-size: 0.6875rem; letter-spacing: 0.08em; }

  .cm-track { position: relative; height: 2px; background: var(--border); }
  .cm-track::before,
  .cm-track::after {
    content: '';
    position: absolute;
    top: -3px;
    width: 1px;
    height: 8px;
    background: var(--border);
  }
  .cm-track::before { left: 0; }
  .cm-track::after { right: 0; }
  .cm-thumb {
    position: absolute;
    top: 50%;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--tape);
    transform: translate(-50%, -50%);
    transition: left 220ms cubic-bezier(0.4, 0, 0.2, 1);
  }


  @media (max-width: 680px) {
    .cm-trait { grid-template-columns: 1fr auto 1fr; gap: 0.5rem; }
    .cm-side .jp { font-size: 0.9375rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cm-thumb, .cm-side { transition: none; }
  }
</style>
